  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blood-and-thunder.invalid/m5/competition-authoring-v1",
  "title": "Proposed supplemental competition authoring schemas, not runtime/save schemas",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "weighted": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "weight": {
          "type": "number",
          "minimum": 1e-06,
          "maximum": 1000000
        }
      },
      "required": [
        "id",
        "weight"
      ]
    },
    "weights": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/weighted"
      },
      "minItems": 1,
      "maxItems": 128
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authority": {
          "enum": [
            "canon",
            "native-contract",
            "audit-proposal"
          ]
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "startLine": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "endLine": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      },
      "required": [
        "authority",
        "file",
        "sha256",
        "startLine",
        "endLine"
      ]
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "const": 1
        },
        "approval": {
          "enum": [
            "UNAPPROVED_EXAMPLE",
            "DRAFT_FOR_REVIEW",
            "APPROVED"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "kind": {
          "enum": [
            "Oval",
            "Circuit",
            "Rally"
          ]
        },
        "resolver": {
          "enum": [
            "native-preset",
            "rally-generator-v1"
          ]
        },
        "nativeId": {
          "enum": [
            "short-oval",
            "oval",
            "grand-oval",
            "C01",
            "C02",
            "C03",
            "C04",
            "C05",
            "C06",
            "C07",
            "C08",
            "C09",
            "C10",
            "C11",
            "C12",
            "technical-circuit",
            "fast-circuit",
            "mixed-rally",
            "technical-rally",
            "generated-short",
            "generated-medium",
            "generated-long"
          ]
        },
        "laneCount": {
          "const": 4
        },
        "laneWidth": {
          "type": "number",
          "minimum": 1,
          "maximum": 4
        },
        "rallyOptions": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "category": {
                  "enum": [
                    "short",
                    "medium",
                    "long"
                  ]
                },
                "turnFrequency": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "turnSeverity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "terrainProfile": {
                  "enum": [
                    "balanced",
                    "road",
                    "rugged"
                  ]
                },
                "maxAttempts": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 32
                }
              },
              "required": [
                "category",
                "turnFrequency",
                "turnSeverity",
                "terrainProfile",
                "maxAttempts"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "checkpointPolicy": {
          "enum": [
            "native-three-v1",
            "category-sign-points-v1"
          ]
        },
        "freezeResolvedCourse": {
          "const": true
        }
      },
      "required": [
        "id",
        "version",
        "approval",
        "label",
        "sources",
        "kind",
        "resolver",
        "nativeId",
        "laneCount",
        "laneWidth",
        "rallyOptions",
        "checkpointPolicy",
        "freezeResolvedCourse"
